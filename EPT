-- ================================================================
-- COLLECTION ENGINE
-- ================================================================

local function GetCollectibles()
    local items = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            local name = obj.Name:lower()
            if name:find("collect") or name:find("drop") or name:find("gem") or 
               name:find("orb") or name:find("coin") or name:find("crystal") then
                if obj.Parent and not obj.Parent:FindFirstChild("Humanoid") then
                    table.insert(items, obj)
                end
            end
        end
    end
    return items
end

local function CollectObject(obj)
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local dist = (hrp.Position - obj.Position).Magnitude
        if dist > 25 then
            hrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 2, 0))
            task.wait(0.1)
        end
        FireRemote("collect", obj)
        FarmState.CollectedObjects[obj] = os.time()
        return true
    end
    return false
end

local function CollectAllNearby()
    local items = GetCollectibles()
    local count = 0
    for _, obj in ipairs(items) do
        if not FarmState.CollectedObjects[obj] or os.time() - FarmState.CollectedObjects[obj] > 3 then
            if CollectObject(obj) then
                count = count + 1
            end
            task.wait(FarmState.CollectInterval)
        end
    end
    return count
end

-- ================================================================
-- BUILD ENGINE
-- ================================================================

local function GetBuildables()
    local items = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("build") or name:find("construct") or name:find("upgrade") or 
               name:find("structure") or name:find("place") then
                if not obj:FindFirstChild("Built") and obj.Parent ~= lp.Character then
                    table.insert(items, obj)
                end
            end
        end
    end
    return items
end

local function BuildStructure(obj)
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local pos = obj.Position or obj:GetPivot().Position
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        task.wait(0.2)
        FireRemote("build", obj)
        FarmState.PendingBuilds[obj] = os.time() + 2
        return true
    end
    return false
end

local function BuildAllAvailable()
    local items = GetBuildables()
    local count = 0
    for _, obj in ipairs(items) do
        if not FarmState.PendingBuilds[obj] or os.time() > FarmState.PendingBuilds[obj] then
            if BuildStructure(obj) then
                count = count + 1
            end
            task.wait(FarmState.BuildInterval)
        end
    end
    return count
end

-- ================================================================
-- REBIRTH ENGINE
-- ================================================================

local function GetRebirthCount()
    local stats = lp:FindFirstChild("leaderstats")
    if stats then
        for _, child in ipairs(stats:GetChildren()) do
            local name = child.Name:lower()
            if name:find("rebirth") or name:find("prestige") then
                return child.Value
            end
        end
    end
    return FarmState.CurrentRebirths
end

local function CheckRebirthCondition()
    local stats = lp:FindFirstChild("leaderstats")
    if stats then
        for _, child in ipairs(stats:GetChildren()) do
            local name = child.Name:lower()
            if name:find("level") or name:find("stage") then
                if child.Value >= FarmState.RebirthThreshold then
                    return true
                end
            end
        end
    end
    return false
end

local function PerformRebirth()
    FarmState.CurrentRebirths = GetRebirthCount()
    
    -- Thử các cách trigger rebirth
    FireRemote("rebirth", "trigger")
    FireRemote("rebirth", "confirm")
    FireRemote("Rebirth", "Start")
    FireRemote("Prestige", "Start")
    
    task.wait(2)
    
    if FarmState.TargetSkill then
        FireRemote("equip_mystery_spell", FarmState.TargetSkill)
        task.wait(0.5)
    end
    
    FarmState.CurrentRebirths = FarmState.CurrentRebirths + 1
    return true
end

