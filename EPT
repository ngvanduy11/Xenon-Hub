local function EquipSkill(skillName)
    if Remote then
        Remote:FireServer("equip_mystery_spell", skillName)
        return true
    end
    return false
end

local function RunFarmCycle()
    while FarmState.Active do
        if FarmState.CollectAll then
            local collected = CollectAllNearby()
            task.wait(0.2)
        end
        
        if FarmState.BuildAll then
            local built = BuildAllAvailable()
            task.wait(0.2)
        end
        
        if FarmState.AutoRebirthEnabled and CheckRebirthCondition() then
            PerformRebirth()
            task.wait(2)
        end
        
        task.wait(0.1)
    end
end

