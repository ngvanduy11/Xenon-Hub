    CollectedObjects = {},
    SmartMode = false,
    AutoEquipSkill = false
}

local function FireRemote(action, ...)
    if Remote then
        pcall(function()
            Remote:FireServer(action, ...)
        end)
    end
end

local function GetCollectibles()
    local collectibles = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            if obj.Name:find("Collect") or obj.Name:find("Drop") or obj.Name:find("Gem") or obj.Name:find("Orb") or obj.Name:find("Coin") then
                if obj.Parent and obj.Parent:FindFirstChild("Humanoid") == nil then
                    table.insert(collectibles, obj)
                end
            end
        end
    end
    return collectibles
end

local function CollectObject(obj)
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local distance = (hrp.Position - obj.Position).Magnitude
        if distance > 30 then
            hrp.CFrame = CFrame.new(obj.Position + Vector3.new(0, 2, 0))
            task.wait(0.1)
        end
        FireRemote("collect", obj)
        FarmState.CollectedObjects[obj] = os.time()
        return true
    end
    return false
end

local function CollectAllNearby()
    local collectibles = GetCollectibles()
    local collected = 0
    for _, obj in ipairs(collectibles) do
        if not FarmState.CollectedObjects[obj] or os.time() - FarmState.CollectedObjects[obj] > 5 then
            local success = CollectObject(obj)
            if success then collected = collected + 1 end
            task.wait(FarmState.CollectInterval)
        end
    end
    return collected
end

local function GetBuildables()
    local buildables = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            if obj.Name:find("Build") or obj.Name:find("Construct") or obj.Name:find("Upgrade") or obj.Name:find("Structure") then
                if not obj:FindFirstChild("Built") and obj.Parent ~= lp.Character then
                    table.insert(buildables, obj)
                end
            end
        end
    end
    return buildables
end

local function BuildStructure(obj)
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local position = obj.Position or obj:GetPivot().Position
        hrp.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
        task.wait(0.2)
        FireRemote("build", obj)
        FarmState.PendingBuilds[obj] = os.time() + 2
        return true
    end
    return false
end

local function BuildAllAvailable()
    local buildables = GetBuildables()
    local built = 0
    for _, obj in ipairs(buildables) do
        if not FarmState.PendingBuilds[obj] or os.time() > FarmState.PendingBuilds[obj] then
            local success = BuildStructure(obj)
            if success then built = built + 1 end
            task.wait(FarmState.BuildInterval)
        end
    end
    return built
end

local function GetRebirthCount()
    local stats = lp:FindFirstChild("leaderstats")
    if stats then
        local rb = stats:FindFirstChild("Rebirths") or stats:FindFirstChild("Rebirth")
        if rb then return rb.Value end
    end
    local playerData = lp:FindFirstChild("PlayerData")
    if playerData then
        local rb = playerData:FindFirstChild("Rebirths") or playerData:FindFirstChild("TotalRebirths")
        if rb then return rb.Value end
    end
    return FarmState.CurrentRebirths
end

local function PerformRebirth()
    local rebirths = GetRebirthCount()
    FarmState.CurrentRebirths = rebirths
    
    FireRemote("rebirth", "trigger")
    FireRemote("rebirth", "confirm")
    task.wait(2)
    
    if FarmState.TargetSkill then
        FireRemote("equip_mystery_spell", FarmState.TargetSkill)
        task.wait(0.5)
    end
    
    FarmState.CurrentRebirths = FarmState.CurrentRebirths + 1
    return true
end

local function CheckRebirthCondition()
    local stats = lp:FindFirstChild("leaderstats")
    if stats then
        local level = stats:FindFirstChild("Level")
        if level and level.Value >= FarmState.RebirthThreshold then
            return true
        end
    end
    return false
end

